NODE_ENV=development
APP_ENV=dev
PORT=8000
FRONTEND_URL=http://localhost:8000
# Opcional: múltiplas URLs separadas por vírgula (útil quando o Vite sobe em outra porta, como 5173/5174)
# FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# ----------------------------------------------------
# Spotify OAuth (Authorization Code + PKCE)
# Crie um app em https://developer.spotify.com/dashboard e copie o Client ID.
# Não há Client Secret: o PKCE dispensa segredo.
# Em "Redirect URIs", cadastre EXATAMENTE a URL de callback abaixo
# (o Spotify exige o IP de loopback 127.0.0.1, não "localhost").
# ----------------------------------------------------
# Preencha apenas se for usar Spotify; deixe vazio para testar Arquivo.
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/spotify/callback

# ----------------------------------------------------
# YouTube Music via cookie (usado para ler e criar playlists neste provedor)
# Cole o cabeçalho Cookie completo de music.youtube.com.
# ----------------------------------------------------
# Preencha apenas se for usar YouTube Music, ou salve pelo painel.
YTMUSIC_COOKIE=
# YTMUSIC_AUTH_USER=0
# YOUTUBE_MUSIC_GL=BR
# YOUTUBE_MUSIC_HL=pt-BR
# YTMUSIC_ADD_CHUNK_SIZE=100

# ----------------------------------------------------
# Deezer (opcional). Leitura de playlists públicas e busca funcionam sem nada.
# Para listar suas playlists, ler privadas e criar playlists, cole o cookie
# "arl" de deezer.com em Integrações ou defina aqui.
# ----------------------------------------------------
# DEEZER_ARL=
# DEEZER_SEARCH_DELAY_MS=220

# ----------------------------------------------------
# TIDAL (opcional). Crie um app em https://developer.tidal.com, cadastre a
# Redirect URI abaixo e copie o Client ID. O Client Secret é opcional: com ele,
# playlists públicas e a busca funcionam sem conectar a conta.
# ----------------------------------------------------
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=
# TIDAL_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/tidal/callback
# TIDAL_COUNTRY_CODE=BR

# ----------------------------------------------------
# Apple Music (opcional). Oficial: chave MusicKit de uma conta Apple Developer
# (Certificates, Identifiers & Profiles > Keys > Media Services). Depois é só
# clicar em "Conectar com Apple Music" no painel.
# Sem chave própria: cole no painel o cookie media-user-token de
# music.apple.com. O token público do web player é obtido automaticamente
# quando habilitado; o campo para colá-lo manualmente é opcional (não oficial).
# ----------------------------------------------------
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/caminho/AuthKey_XXXXXXXXXX.p8
# Alternativa ao arquivo: APPLE_PRIVATE_KEY com quebras de linha representadas por \n.
# APPLE_PRIVATE_KEY=
# APPLE_MUSIC_STOREFRONT=br
# APPLE_MUSIC_USER_TOKEN=
# APPLE_MUSIC_DEVELOPER_TOKEN=
# APPLE_MUSIC_AUTO_WEB_TOKEN=true

# ----------------------------------------------------
# SoundCloud (opcional). Leitura de playlists públicas e busca funcionam sem
# nada (client_id público do site). Para criar playlists, cole o cookie
# oauth_token de soundcloud.com em Integrações ou defina aqui.
# ----------------------------------------------------
# SOUNDCLOUD_OAUTH_TOKEN=
# SOUNDCLOUD_CLIENT_ID=

# ----------------------------------------------------
# Opcionais
# ----------------------------------------------------
# Trabalhador (fila local persistida). Use false para não processar transferências neste processo.
WORKER_ENABLED=true
YT_MUSIC_SEARCH_DELAY_MS=750
YOUTUBE_SEARCH_CONCURRENCY=1
# Tentativas por faixa com erro temporário antes de ir para as pendências.
# MAX_TRACK_ATTEMPTS=5
# Atrasos opcionais por plataforma, em milissegundos.
# SPOTIFY_SEARCH_DELAY_MS=100
# TIDAL_SEARCH_DELAY_MS=250
# APPLE_MUSIC_SEARCH_DELAY_MS=200
# SOUNDCLOUD_SEARCH_DELAY_MS=300

# Criptografia das credenciais locais. Opcional: se não definir, uma chave é
# gerada automaticamente em data/encryption.key na primeira execução.
# Para fixar uma chave, gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Onde guardar os dados locais (credenciais cifradas + histórico). Padrão: backend/data
# DATA_DIR=
