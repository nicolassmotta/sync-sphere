NODE_ENV=development
APP_ENV=dev
PORT=8000
FRONTEND_URL=http://localhost:8000
# Opcional: múltiplas URLs separadas por vírgula (útil quando o Vite sobe em outra porta, como 5173/5174)
# FRONTEND_URLS=http://localhost:5173,http://localhost:5174

# ----------------------------------------------------
# Spotify OAuth (Authorization Code + PKCE)
# Crie um app em https://developer.spotify.com/dashboard e copie o Client ID.
# Não há Client Secret: o PKCE dispensa segredo.
# Em "Redirect URIs", cadastre EXATAMENTE a URL de callback abaixo
# (o Spotify exige o IP de loopback 127.0.0.1, não "localhost").
# ----------------------------------------------------
SPOTIFY_CLIENT_ID=seu_client_id_spotify
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/spotify/callback

# ----------------------------------------------------
# YouTube Music via cookie (obrigatório para criar playlists no YouTube Music)
# Cole o cabeçalho Cookie completo de music.youtube.com.
# ----------------------------------------------------
YTMUSIC_COOKIE=cole_o_cabecalho_cookie_completo_de_music_youtube_com_aqui
# YTMUSIC_AUTH_USER=0
# YOUTUBE_MUSIC_GL=BR
# YOUTUBE_MUSIC_HL=pt-BR
# YTMUSIC_ADD_CHUNK_SIZE=100

# ----------------------------------------------------
# Opcionais
# ----------------------------------------------------
# Trabalhador (fila local em memória). Use false para não processar transferências neste processo.
WORKER_ENABLED=true
YT_MUSIC_SEARCH_DELAY_MS=750
YOUTUBE_SEARCH_CONCURRENCY=1

# Criptografia das credenciais locais. Opcional: se não definir, uma chave é
# gerada automaticamente em data/encryption.key na primeira execução.
# Para fixar uma chave, gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Onde guardar os dados locais (credenciais cifradas + histórico). Padrão: backend/data
# DATA_DIR=
